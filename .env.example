# Mailgeko environment variables
# Copy to .env and adjust. With docker-compose.full.yml only JWT_SECRET is
# required — the DB services are bundled. With docker-compose.yml the app
# expects externally-provisioned MySQL/Redis (and optionally Postgres).

# --- Required ---
# Signing key for auth tokens. Generate: openssl rand -hex 32
JWT_SECRET=

# --- Email sending (Resend-compatible API) ---
# Comma-separated API keys accepted by the sender. The API refuses to start
# without a value (it rotates through keys to spread domain quotas). The
# placeholder boots the stack; set a real key (or RESEND_API_ENDPOINT pointing
# at a mock) to actually send.
RESEND_API_KEYS=re_dev_placeholder
# Override for local/mock endpoints, e.g. http://host.docker.internal:8787/emails
RESEND_API_ENDPOINT=https://api.resend.com/emails

# --- Public base URL (used for tracking/unsubscribe links inside emails) ---
# Must be reachable by recipients and must route /track/* and /webhooks/* to the app.
BASE_URL=http://localhost:3000

# --- Vector search / AI (optional) ---
# static = built-in deterministic embeddings (works with no API key)
# openai = real embeddings via OPENAI_API_KEY
EMBED_PROVIDER=static
EMBED_BASE_URL=
EMBED_MODEL=text-embedding-3-small
EMBED_DIMENSIONS=1536
# AI Studio chat completions. The client is OpenAI-compatible, so any
# provider works. Examples:
#   OpenAI:   AI_BASE_URL=https://api.openai.com/v1, AI_MODEL=gpt-4o-mini
#   Groq:     AI_BASE_URL=https://api.groq.com/openai/v1, AI_MODEL=llama-3.3-70b-versatile, OPENAI_API_KEY=gsk_...
# Leave OPENAI_API_KEY empty to use built-in template fallbacks.
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# --- Billing (optional; defaults to local gateway) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=

# --- Image uploads (optional; Cloudinary) ---
# Leave empty to disable avatar/logo uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Social sign-in (optional; Google + GitHub OAuth) ---
# Google redirect URI: <BASE_URL>/api/v1/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub callback URL: <BASE_URL>/api/v1/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- External datastores (only used with docker-compose.yml) ---
# MySQL / TiDB-compatible
# TIDB_DSN=mailgeko:mailgeko@tcp(127.0.0.1:3306)/mailgeko?parseTime=true&charset=utf8mb4
# REDIS_ADDR=127.0.0.1:6379
# Postgres + pgvector (enables analytics + vector search)
# POSTGRES_DSN=postgres://postgres:postgres@127.0.0.1:5432/mailgeko?sslmode=disable

# --- App ---
# PORT=8080
# APP_ENV=production
# Comma-separated CIDRs of proxies in front of the app (defaults to loopback).
# Client IPs are only trusted from these hops; the middleware sets x-mg-client-ip.
# TRUSTED_PROXY_IPS=127.0.0.1/32,::1/128
# Run SQL migrations on boot. Set false to run them separately (docker run ... cmd/migrate).
# AUTO_MIGRATE=true
# Process split for horizontal scaling: all | api | worker | web. Default: all.
# MAILGEKO_ROLE=all
