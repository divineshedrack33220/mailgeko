# Copy to .env and fill in real values.

APP_ENV=development
PORT=8080
LOG_LEVEL=info

# TiDB (MySQL-compatible) connection string.
TIDB_DSN=root:@tcp(127.0.0.1:4000)/mailgeko?parseTime=true&charset=utf8mb4

# Postgres + pgvector connection string (analytics + vector search). Optional:
# when unset the API still serves auth/contacts/campaigns but analytics
# endpoints return 503 and the worker skips Postgres event logging.
POSTGRES_DSN=postgres://postgres:postgres@localhost:5432/mailgeko?sslmode=disable

# Redis connection (cache, rate limits, asynq queues).
REDIS_ADDR=localhost:6379

# Secret used to sign JWTs. Generate with: openssl rand -hex 32
JWT_SECRET=change-me

# Comma-separated Resend API keys; the sender rotates through them to spread
# domain quotas and avoid hitting rate limits.
RESEND_API_KEYS=re_xxxxxxxx,re_yyyyyyyy

# Resend API endpoint. Override for local testing / mock servers.
RESEND_API_ENDPOINT=https://api.resend.com/emails

# Public base URL used in tracking links and unsubscribe URLs.
BASE_URL=http://localhost:8080

# --- Vector search (semantic contact search) ---
# Embeds contact profiles and powers GET /api/v1/contacts/search?q= and
# GET /api/v1/contacts/{id}/similar. Requires POSTGRES_DSN.
#
# Provider "openai" uses an OpenAI-compatible /embeddings API. Set OPENAI_API_KEY
# and optionally EMBED_MODEL / EMBED_BASE_URL / EMBED_DIMENSIONS (must match the
# model, e.g. 1536 for text-embedding-3-small). If the key is empty the embedder
# is disabled and search returns 503.
#
# Provider "static" uses a deterministic hash-based embedder that needs no API
# key and is only useful for local smoke tests (scores are meaningless).
EMBED_PROVIDER=openai
OPENAI_API_KEY=
EMBED_MODEL=text-embedding-3-small
# EMBED_BASE_URL=https://api.openai.com/v1
# EMBED_DIMENSIONS=1536

# --- Billing (Stripe) ---
# Provider "stripe" (set STRIPE_SECRET_KEY) talks to the Stripe API and returns
# real checkout / portal URLs; webhooks are verified with STRIPE_WEBHOOK_SECRET.
# Provider "local" (default, no key) completes checkouts immediately and is for
# offline dev/smoke tests. Stripe price IDs map plans to your Stripe prices.
BILLING_PROVIDER=local
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_STARTER=price_...
# STRIPE_PRICE_GROWTH=price_...
# STRIPE_PRICE_SCALE=price_...
